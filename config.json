{
  "SECRETS_PATH": "d:\\projects\\fullstack-demo\\.secrets",
  "SCAN": {
    "GIT_PROJECTS": [
      "https://github.com/AlexOstrov/example.git", "https://github.com/AlexOstrov/KK.git"
    ],
    "DB_PATH": "db/scan.db",
    "MIRROR_DIR": "db/repos/",
    "MIRROR_FILTER": "auto",
    "BRANCHES": "all",
    "BRANCH_INCLUDE": [],
    "BRANCH_EXCLUDE": [],
    "INCLUDE": [
      "**/*.txt",
      "**/*.md",
      "**/*.html"
    ],
    "EXCLUDE": [],
    "EXCLUDE_SECRETS": [],
    "MAX_FILE_SIZE": 1048576,
    "ENCODING": "utf-8",
    "FALLBACK_ENCODING": "cp1251",
    "STRICT": false,
    "GC_HASHES": true,
    "LOG_PATH": "logs/scan.log"
  },
  "ANALYSIS": {
    "GIT_DAY": 4,
    "BRANCHES": "all",
    "FIRST_PARENT": false,
    "MAX_DIFF_CHARS_PER_CHUNK": 12000,
    "MAX_PATCH_CHARS_PER_FILE": 4000,
    "MAX_CHUNK_RETRIES": 3,
    "BACKOFF_FACTOR": 2,
    "CONCURRENCY": 1,
    "EXCLUDE": [
      "*.lock",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "composer.lock",
      "poetry.lock",
      "Cargo.lock",
      "*.min.js",
      "*.min.css",
      "*.map",
      "dist/**",
      "build/**",
      "vendor/**",
      "node_modules/**",
      ".git/**"
    ],
    "PROMPT_VERSION": 1,
    "LINK_REQUIREMENTS": true,
    "OUTPUT_DIR": "reports/",
    "MEMORY_DIR": "docs/memory/",
    "LOG_PATH": "logs/analysis.log",
    "DB_PATH": "db/analysis.db",
    "DB_RETENTION_DAYS": 60
  },
  "LLM": {
    "PROVIDER": "mistral",
    "MODEL": null,
    "NON_INTERACTIVE": false,
    "PROBE_OLLAMA": true,
    "MODEL_CACHE_TTL": 3600,
    "HTTP_TIMEOUT": 30,
    "MISTRAL_MODEL": "mistral-small-latest",
    "MISTRAL_ENDPOINT": "https://api.mistral.ai/v1",
    "OLLAMA_BASE_URL": "http://localhost:11434",
    "OLLAMA_MODEL": "llama3.1:8b"
  }
}
